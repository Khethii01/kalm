{
  "name": "kalm-group-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Corporate website for KALM Group (Pty) Ltd — commercial and bulk fuel supply.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.config.ssr.ts",
    "prerender": "node scripts/prerender.mjs",
    "build": "tsc -b && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
